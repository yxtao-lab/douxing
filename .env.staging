# 测试环境（pnpm build:*:staging 自动加载，mode=staging）
# 小程序体验版、测试联调使用此配置打包

VITE_API_BASE_URL=https://api-test.yxtao.site/api

# 服务器部署测试 API 时，将 deploy/env.staging.example 复制为 .env 并设置：
# API_PUBLIC_BASE_URL=https://api-test.yxtao.site

# 若暂无独立测试域名，可暂时改为与生产相同（不推荐长期共用）：
# VITE_API_BASE_URL=https://api.yxtao.site/api
