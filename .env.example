# MySQL
# 本地 MySQL：使用 root 账号，并保证 DATABASE_URL 与下面一致
# Docker 部署：取消注释 MYSQL_IMAGE，使用 douxing 用户（见下方注释块）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=douxing
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# 后端实际读取此连接串（用户名/密码必须与本地 MySQL 一致）
DATABASE_URL=mysql://root:123456@localhost:3306/douxing

# Docker 容器映射到宿主机的端口（勿与上面本机 3306 重复）
# DOCKER_MYSQL_HOST_PORT=3307
# 使用 Docker MySQL 时 DATABASE_URL 端口改为 3307：
# DATABASE_URL=mysql://douxing:douxing123@localhost:3307/douxing

# Docker 可选配置（先 docker pull 测试哪条线路可用）
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
# MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
# MYSQL_IMAGE=docker.xuanyuan.me/library/mysql:8.0
# MYSQL_USER=douxing
# MYSQL_PASSWORD=douxing123
# DATABASE_URL=mysql://douxing:douxing123@localhost:3306/douxing

# Server
SERVER_PORT=3000
NODE_ENV=development
# 待支付订单超时自动取消（分钟，默认 30）
# ORDER_PENDING_TIMEOUT_MINUTES=30
# 超时扫描间隔（秒，默认 60，最小 10）
# ORDER_TIMEOUT_SCAN_INTERVAL_SEC=60

# 支付：mock（模拟）| wechat（仅微信）| auto（已配置微信且传 wxCode 时走微信，否则 mock）
# PAYMENT_MODE=auto
# 路线完整行程是否需要支付解锁（默认 false：生成后直接可查看；true 时走原解锁/订单逻辑）
# ROUTE_UNLOCK_PAYMENT_REQUIRED=false
# 微信支付（商户平台 + 小程序 AppID 绑定）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=wx8bdbe398733ca0f0
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_PATH=./certs/apiclient_cert.pem
# WECHAT_PAY_NOTIFY_URL=https://你的域名/api/payments/wechat/notify
# 小程序 AppSecret（code 换 openid，微信公众平台-开发管理）
# WECHAT_MINI_APP_SECRET=
# MySQL 连接时区（默认东八区，与 Docker MySQL --default-time-zone 一致）
# DB_TIMEZONE=+08:00
# 头像等静态资源对外访问根地址（服务端运行时读取，不含在 DB 头像字段里）
# 接口返回 uploads 资源时动态拼接：{基址}/uploads/avatars/xxx.jpg
# 推荐分环境配置（后端按 NODE_ENV 自动选取；也可写 API_PUBLIC_BASE_URL 覆盖）：
API_PUBLIC_BASE_URL_DVE=http://127.0.0.1:3000
API_PUBLIC_BASE_URL_PROD=https://api.yxtao.site
# API_PUBLIC_BASE_URL=

# LM Studio（OpenAI 兼容 API，本地默认 http://127.0.0.1:1234）
# 在 LM Studio 中加载模型并开启 Local Server 后使用
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 与 LM Studio 当前加载的模型 ID 一致（可在 GET /v1/models 查看）
# 填 LM Studio 已加载的模型 ID，或 local-model 自动取 /v1/models 第一个
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_MS=120000
# 默认模型：auto | deepseek | lmstudio
LLM_DEFAULT_PROVIDER=auto

# DeepSeek（密钥勿提交 Git，仅在 .env 中配置）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# Python AI 微服务（C5，可选；启用后 Node 优先调用 LangChain 服务，失败则回退 Node LLM / 模板）
# AI_SERVICE_ENABLED=true
# AI_SERVICE_URL=http://127.0.0.1:8100
# AI_SERVICE_TIMEOUT_MS=120000
# AI_SERVICE_PORT=8100

# 高德 Web 服务（地理编码 / POI 搜索，补全 attractions 坐标）
# 控制台：https://console.amap.com/dev/key/app  创建「Web 服务」类型 Key
# AMAP_WEB_KEY=
# AMAP_ENABLED=true
# AMAP_GEOCODE_TIMEOUT_MS=8000
# 地理编码 Redis 缓存（按 city+name 去重，降低高德配额消耗）
# AMAP_GEOCODE_CACHE_TTL_SEC=2592000
# 景点封面自动补全（高德 POI 图 → uploads/attractions，默认跟随 AMAP_ENABLED）
# AMAP_IMAGE_ENRICH_ENABLED=true
# AMAP_IMAGE_FETCH_DELAY_MS=300

# Redis（docker compose 启动 redis 服务后使用）
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_ENABLED=true
# DOCKER_REDIS_HOST_PORT=6379
# REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine

# 打卡地理围栏（默认 true；本地调试跳过距离/精度/速度校验请设为 false，注意行前不要加 #）
CHECKIN_GEOFENCE_ENABLED=true

# H9-3 跨城大交通班次（默认 auto：Juhe(若配置) → 班次库 → 参考模板）
# INTERCITY_ENABLED=true
# INTERCITY_PROVIDER=auto
# catalog | template | juhe
# INTERCITY_REQUEST_TIMEOUT_MS=8000
# INTERCITY_CACHE_TTL_SEC=21600
# 聚合数据火车订票查询（可选，https://www.juhe.cn/docs/api/id/817）
# JUHE_API_KEY=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 短信验证码
# 渠道：auto（已配置腾讯云则用腾讯云，否则 mock）| tencent | mock
SMS_PROVIDER=auto
# 开发环境 mock 模式下会在接口响应和控制台输出验证码
# SMS_DEV_EXPOSE_CODE=true

# 腾讯云短信（控制台：https://console.cloud.tencent.com/smsv2）
# 子账号需授予 QcloudSMSFullAccess；模板变量按 {1}、{2} 顺序传参
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou
# 若模板含有效期变量（如「{2}分钟内有效」），填写分钟数
# TENCENT_SMS_TEMPLATE_MINUTES=5

# 语音识别（小程序录音上传后由服务端识别，可与短信共用 TENCENT_SECRET_ID / TENCENT_SECRET_KEY）
# 需在腾讯云控制台开通「语音识别 ASR」：https://console.cloud.tencent.com/asr
# SPEECH_PROVIDER=auto
# TENCENT_ASR_REGION=ap-guangzhou

# 前端 / 小程序 API 地址（按环境自动加载，详见 docs/env-environments.md）
# .env.development  → 本地 dev（127.0.0.1）
# .env.staging      → 测试包（api-test.yxtao.site）
# .env.production   → 生产包（api.yxtao.site）
# 本地 .env 仍可覆盖；后端密钥、数据库等仍只读根目录 .env

# VITE_API_BASE_URL=http://127.0.0.1:3000/api
# D5-a：移动端 H5 根地址（海报二维码指向 #/pages/share/route?id=…）
# VITE_H5_BASE_URL=http://127.0.0.1:5173

# 微信小程序 AppID（已写入 packages/mobile/src/manifest.json）
# MP_WEIXIN_APPID=wx8bdbe398733ca0f0
