# MySQL
# 本地 MySQL：使用 root 账号，并保证 DATABASE_URL 与下面一致
# Docker 部署：取消注释 MYSQL_IMAGE，使用 douxing 用户（见下方注释块）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=douxing
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# 后端实际读取此连接串（用户名/密码必须与本地 MySQL 一致）
DATABASE_URL=mysql://root:123456@localhost:3306/douxing

# Docker 容器映射到宿主机的端口（勿与上面本机 3306 重复）
# DOCKER_MYSQL_HOST_PORT=3307
# 使用 Docker MySQL 时 DATABASE_URL 端口改为 3307：
# DATABASE_URL=mysql://douxing:douxing123@localhost:3307/douxing

# Docker 可选配置（先 docker pull 测试哪条线路可用）
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
# MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
# MYSQL_IMAGE=docker.xuanyuan.me/library/mysql:8.0
# MYSQL_USER=douxing
# MYSQL_PASSWORD=douxing123
# DATABASE_URL=mysql://douxing:douxing123@localhost:3306/douxing

# Server
SERVER_PORT=3000
NODE_ENV=development
# 待支付订单超时自动取消（分钟，默认 30）
# ORDER_PENDING_TIMEOUT_MINUTES=30
# 超时扫描间隔（秒，默认 60，最小 10）
# ORDER_TIMEOUT_SCAN_INTERVAL_SEC=60

# 数据中台 · 系统资源统计（远程 Git 浅克隆，不扫本机业务工作区）
# 不配 REMOTE 时回退读取本机仓库 origin；部署机需能访问该远程（SSH key 或 HTTPS token）
# SYSTEM_RESOURCES_GIT_REMOTE=git@gitee.com:tyxgo/douxing.git
# SYSTEM_RESOURCES_GIT_BRANCH=main
# SYSTEM_RESOURCES_GIT_DEPTH=120
# 克隆缓存目录（须为绝对路径或相对进程 cwd；勿放到仓库 .git/ 下）
# 留空则使用系统临时目录 douxing-system-resources-git
# SYSTEM_RESOURCES_GIT_CACHE_DIR=
# 可选：显式指定本机 monorepo 根（仅用于回退读取 origin，不用于扫代码）
# PROJECT_ROOT=

# 支付：mock（模拟）| wechat（仅微信）| auto（已配置微信且传 wxCode 时走微信，否则 mock）
# PAYMENT_MODE=auto
# 路线完整行程是否需要支付解锁（默认 false：生成后直接可查看；true 时走原解锁/订单逻辑）
# ROUTE_UNLOCK_PAYMENT_REQUIRED=false
# 微信支付（商户平台 + 小程序 AppID 绑定）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=wx2c8d1e2b2e502819
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_PATH=./certs/apiclient_cert.pem
# WECHAT_PAY_NOTIFY_URL=https://你的域名/api/payments/wechat/notify
# 小程序 AppSecret（code 换 openid，微信公众平台-开发管理）
# WECHAT_MINI_APP_SECRET=
# MySQL 连接时区（默认东八区，与 Docker MySQL --default-time-zone 一致）
# DB_TIMEZONE=+08:00
# 头像等静态资源对外访问根地址（服务端运行时读取，不含在 DB 头像字段里）
# 接口返回 uploads 资源时动态拼接：{基址}/uploads/avatars/xxx.jpg
# 推荐分环境配置（后端按 NODE_ENV 自动选取；也可写 API_PUBLIC_BASE_URL 覆盖）：
API_PUBLIC_BASE_URL_DVE=http://127.0.0.1:3000
API_PUBLIC_BASE_URL_PROD=https://api.yxtao.site
# API_PUBLIC_BASE_URL=

# LM Studio（OpenAI 兼容 API，本地默认 http://127.0.0.1:1234）
# 在 LM Studio 中加载模型并开启 Local Server 后使用
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 与 LM Studio 当前加载的模型 ID 一致（可在 GET /v1/models 查看）
# 填 LM Studio 已加载的模型 ID，或 local-model 自动取 /v1/models 第一个
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_MS=120000
# 默认模型：auto | deepseek | lmstudio
LLM_DEFAULT_PROVIDER=auto

# DeepSeek（密钥勿提交 Git，仅在 .env 中配置）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# Python AI 微服务（C5，可选；启用后 Node 优先调用 LangChain 服务，失败则回退 Node LLM / 模板）
# AI_SERVICE_ENABLED=true
# AI_SERVICE_URL=http://127.0.0.1:8100
# AI_SERVICE_TIMEOUT_MS=120000
# AI_SERVICE_PORT=8100
# W1 · 编排运行时：legacy（默认）| langgraph（staging 建议 langgraph；异常降级 legacy）
# WORKFLOW_ENGINE=legacy

# Langfuse 观测（Step 11，可选；配置后 ai-service / Node LLM 上报 trace）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=default
# W2-5：管理端诊断页 Langfuse 深链（在 Langfuse 项目 Settings 中查看 Project ID）
# LANGFUSE_PROJECT_ID=

# W2-1：LLM / 高德 API 单价（元 / 1K tokens 或每次调用；均为估算）
# LLM_PRICING_DEEPSEEK_INPUT_PER_1K_CNY=0.001
# LLM_PRICING_DEEPSEEK_OUTPUT_PER_1K_CNY=0.002
# LLM_PRICING_DOUXING_INPUT_PER_1K_CNY=0.004
# LLM_PRICING_DOUXING_OUTPUT_PER_1K_CNY=0.012
# LLM_PRICING_LMSTUDIO_INPUT_PER_1K_CNY=0
# LLM_PRICING_LMSTUDIO_OUTPUT_PER_1K_CNY=0
# AMAP_API_CALL_CNY=0

# 高德 Web 服务（地理编码 / POI 搜索，补全 attractions 坐标）
# 控制台：https://console.amap.com/dev/key/app  创建「Web 服务」类型 Key
# AMAP_WEB_KEY=
# AMAP_ENABLED=true
# AMAP_GEOCODE_TIMEOUT_MS=8000
# distance API 最大并发（规避 CUQPS 超限，默认 2；与 direction polyline 共用）
# AMAP_DIRECTION_CONCURRENCY=2
# AMAP_DISTANCE_CONCURRENCY=2
# 地理编码 Redis 缓存（按 city+name 去重，降低高德配额消耗）
# AMAP_GEOCODE_CACHE_TTL_SEC=2592000
# 路网 distance 矩阵 Redis 缓存（对称键，默认 7 天）
# AMAP_MATRIX_CACHE_TTL_SEC=604800
# Haversine 估算缓存 TTL（API 失败/禁用时，默认 15 分钟，减轻 CUQPS）
# AMAP_MATRIX_ESTIMATE_CACHE_TTL_SEC=900
# 缓存键坐标小数位（默认 4≈11m，提高同 POI 命中率；可设 5 更精确）
# AMAP_MATRIX_CACHE_COORD_DECIMALS=4
# 景点封面自动补全（高德 POI 图 → OSS 或 uploads/attractions，默认跟随 AMAP_ENABLED）
# AMAP_IMAGE_ENRICH_ENABLED=true
# AMAP_IMAGE_FETCH_DELAY_MS=300
# Wikimedia Commons 兜底（高德无图时，默认 true）
# Wikimedia 封面兜底（高德无图时）；开发环境默认关闭，生产默认开启
# WIKIMEDIA_IMAGE_ENRICH_ENABLED=true
# WIKIMEDIA_FETCH_TIMEOUT_MS=5000
# WIKIMEDIA_MISS_CACHE_TTL_SEC=86400
# WIKIMEDIA_ERROR_CACHE_TTL_SEC=900

# 景点封面对象存储（阿里云 OSS + CDN，生产多机建议开启；未配置时回退本地 uploads）
# OSS_ENABLED=true
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=douxing-assets
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_CDN_BASE_URL=https://cdn.example.com
# OSS_ATTRACTIONS_PREFIX=attractions/
# OSS_PHOTOS_PREFIX=photos/
# ML 训练数据集（I2 PAI LoRA，与 PAI 同地域 Bucket）
# OSS_ML_DATASETS_PREFIX=douxing/datasets/v0.1/
# OSS_ML_CHECKPOINTS_PREFIX=douxing/checkpoints/v0.1/

# 旅程相册会员配额（默认 true；联调可设 false 跳过校验）
# PHOTO_QUOTA_ENFORCE=true

# Redis（docker compose 启动 redis 服务后使用）
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_ENABLED=true
# DOCKER_REDIS_HOST_PORT=6379
# REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine

# 打卡地理围栏（默认 true；本地调试跳过距离/精度/速度校验请设为 false，注意行前不要加 #）
CHECKIN_GEOFENCE_ENABLED=true

# H9-3 跨城大交通班次（默认 auto：Juhe(若配置) → 班次库 → 参考模板）
# INTERCITY_ENABLED=true
# INTERCITY_PROVIDER=auto
# catalog | template | juhe
# INTERCITY_REQUEST_TIMEOUT_MS=8000
# INTERCITY_CACHE_TTL_SEC=21600
# 聚合数据火车订票查询（可选，https://www.juhe.cn/docs/api/id/817）
# JUHE_API_KEY=

# JWT
JWT_SECRET=change-me-in-production
# Access Token 有效期（短效，建议 15m）
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token 有效期（长效，建议 30d）
JWT_REFRESH_EXPIRES_IN=30d
# 兼容旧配置：未设置 JWT_ACCESS_EXPIRES_IN 时作为 Access Token 有效期
JWT_EXPIRES_IN=7d
# db:seed 管理员（本地默认 admin/admin123；生产 NODE_ENV=production 须设 ADMIN_INITIAL_PASSWORD 才创建）
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# 短信验证码
# 渠道：auto（已配置腾讯云则用腾讯云，否则 mock）| tencent | mock
SMS_PROVIDER=auto
# 开发环境 mock 模式下会在接口响应和控制台输出验证码
# SMS_DEV_EXPOSE_CODE=true

# 腾讯云短信（控制台：https://console.cloud.tencent.com/smsv2）
# 子账号需授予 QcloudSMSFullAccess；模板变量按 {1}、{2} 顺序传参
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou
# 若模板含有效期变量（如「{2}分钟内有效」），填写分钟数
# TENCENT_SMS_TEMPLATE_MINUTES=5

# 语音识别（小程序录音上传后由服务端识别，可与短信共用 TENCENT_SECRET_ID / TENCENT_SECRET_KEY）
# 需在腾讯云控制台开通「语音识别 ASR」：https://console.cloud.tencent.com/asr
# SPEECH_PROVIDER=auto
# TENCENT_ASR_REGION=ap-guangzhou

# 前端 API 与环境（详见 docs/env-environments.md · 执行 pnpm env:status 查看当前配置）
#
# 切换环境 = 换命令，一般不用改文件：
#   本地开发  pnpm dev
#   测试打包  pnpm build:mp-weixin:staging   → 读 .env.staging
#   生产打包  pnpm build:mp-weixin            → 读 .env.production
#
# 本机 dev API 地址写在 .env.local（gitignore），不要写在 .env 里：
#   VITE_API_BASE_URL=http://127.0.0.1:3000/api          # 模拟器
#   VITE_API_BASE_URL=http://192.168.x.x:3000/api        # 真机（ipconfig 查 IP）
#
# .env.development 仅放 dev 共享项（如 VITE_H5_BASE_URL），已在仓库中配置。

# D5-a：移动端 H5 根地址（海报 H5 二维码 → #/pages/share/route?id=…）
# VITE_H5_BASE_URL=http://127.0.0.1:5174

# 管理端工作台跳转 PC 用户端（生产填 https://pc.yourdomain.com；本地 dev 默认 localhost:5176）
# VITE_PC_BASE_URL=https://pc.yxtao.site

# 微信小程序 AppID（已写入 packages/mobile/src/manifest.json）
# MP_WEIXIN_APPID=wx2c8d1e2b2e502819

# 本地 dev 自动打开微信开发者工具（pnpm setup:wechat-devtools 可自动检测并写入 .env.local）
# 开发者工具 → 设置 → 安全设置 → 开启「服务端口」
# WECHAT_DEVTOOLS_CLI=C:/Program Files (x86)/Tencent/微信web开发者工具/cli.bat
# WECHAT_DEVTOOLS_PORT=34829
