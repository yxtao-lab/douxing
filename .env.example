# MySQL
# 本地 MySQL：使用 root 账号，并保证 DATABASE_URL 与下面一致
# Docker 部署：取消注释 MYSQL_IMAGE，使用 douxing 用户（见下方注释块）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=douxing
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# 后端实际读取此连接串（用户名/密码必须与本地 MySQL 一致）
DATABASE_URL=mysql://root:123456@localhost:3306/douxing

# Docker 容器映射到宿主机的端口（勿与上面本机 3306 重复）
# DOCKER_MYSQL_HOST_PORT=3307
# 使用 Docker MySQL 时 DATABASE_URL 端口改为 3307：
# DATABASE_URL=mysql://douxing:douxing123@localhost:3307/douxing

# Docker 可选配置（先 docker pull 测试哪条线路可用）
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
# MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
# MYSQL_IMAGE=docker.xuanyuan.me/library/mysql:8.0
# MYSQL_USER=douxing
# MYSQL_PASSWORD=douxing123
# DATABASE_URL=mysql://douxing:douxing123@localhost:3306/douxing

# Server
SERVER_PORT=3000
NODE_ENV=development

# LM Studio（OpenAI 兼容 API，本地默认 http://127.0.0.1:1234）
# 在 LM Studio 中加载模型并开启 Local Server 后使用
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 与 LM Studio 当前加载的模型 ID 一致（可在 GET /v1/models 查看）
# 填 LM Studio 已加载的模型 ID，或 local-model 自动取 /v1/models 第一个
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_MS=120000
# 默认模型：auto | deepseek | lmstudio
LLM_DEFAULT_PROVIDER=auto

# DeepSeek（密钥勿提交 Git，仅在 .env 中配置）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 前端 / 小程序 API 地址（须与后端 SERVER_PORT 一致）
# H5 开发可用 http://localhost:3000/api
# 微信小程序开发：开发者工具中关闭「校验合法域名」时可用 127.0.0.1
# 微信小程序上线：必须 HTTPS，并在微信公众平台配置 request 合法域名
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# 微信小程序 AppID（已写入 packages/mobile/src/manifest.json）
# MP_WEIXIN_APPID=wx8bdbe398733ca0f0
