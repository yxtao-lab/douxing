{
  "name": "@douxing/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset-database.ts && tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "enricher:demo": "tsx src/scripts/enricher-demo.ts",
    "enrich:attraction-images": "tsx src/scripts/enrich-attraction-images.ts",
    "cleanup:orphan-covers": "tsx src/scripts/cleanup-orphan-attraction-covers.ts",
    "migrate:covers-to-oss": "tsx src/scripts/migrate-attraction-covers-to-oss.ts",
    "ml:generate-dataset": "tsx src/scripts/generate-training-dataset.ts",
    "ml:validate-dataset": "tsx src/scripts/validate-training-dataset.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@douxing/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "exif-parser": "^0.1.12",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0",
    "tencentcloud-sdk-nodejs": "^4.1.235",
    "wechatpay-node-v3": "^2.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
