{
  "name": "@douxing/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:mp-weixin": "node ../../scripts/dev-mp-weixin.mjs",
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "build": "pnpm run build:h5 && pnpm run build:mp-weixin",
    "build:h5": "uni build",
    "build:h5:staging": "uni build --mode staging",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:staging": "uni build -p mp-weixin --mode staging",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "build:app-android:staging": "uni build -p app-android --mode staging",
    "build:app-ios": "uni build -p app-ios",
    "build:app-ios:staging": "uni build -p app-ios --mode staging",
    "build:app-all": "pnpm run build:app-android && pnpm run build:app-ios",
    "build:app-all:staging": "pnpm run build:app-android:staging && pnpm run build:app-ios:staging",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-harmony": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-plus": "3.0.0-4080420251103001",
    "@dcloudio/uni-components": "3.0.0-4080420251103001",
    "@dcloudio/uni-h5": "3.0.0-4080420251103001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080420251103001",
    "@douxing/shared": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.2"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/uni-automator": "3.0.0-4080420251103001",
    "@dcloudio/uni-cli-shared": "3.0.0-4080420251103001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080420251103001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080420251103001",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.7.0",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.0"
  }
}
