{
  "name": "@douxing/or-tools",
  "version": "9.15.0",
  "private": true,
  "description": "兜行对 route-solver（OR-Tools 独立分叉）的工作区封装；上游为 yxtao-lab/route-solver，不跟踪 Google 官方仓库",
  "license": "Apache-2.0",
  "homepage": "https://github.com/yxtao-lab/route-solver",
  "repository": {
    "type": "git",
    "url": "https://github.com/yxtao-lab/route-solver.git",
    "directory": "packages/or-tools/upstream"
  },
  "scripts": {
    "upstream:status": "git -C upstream status -sb && git -C upstream rev-parse --short HEAD && git -C upstream remote -v",
    "upstream:pull": "git -C upstream pull --ff-only",
    "info": "node -e \"console.log('@douxing/or-tools ->', 'https://github.com/yxtao-lab/route-solver'); console.log(require('fs').readFileSync('upstream/Version.txt','utf8').trim())\""
  },
  "files": [
    "upstream/**",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "or-tools",
    "route-solver",
    "tsp",
    "routing",
    "cp-sat",
    "optimization"
  ]
}
