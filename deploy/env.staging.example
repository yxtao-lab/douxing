# ============================================================
# 兜行 · 测试环境服务端配置示例
# 复制到项目根目录并重命名为 .env（测试服务器上）：
#   cp deploy/env.staging.example .env
# ============================================================

# ---------- 域名与对外地址（必填） ----------
API_PUBLIC_BASE_URL=https://api-test.yxtao.site
VITE_API_BASE_URL=https://api-test.yxtao.site/api

# ---------- 数据库（可与生产同机不同库，或独立测试机） ----------
MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=douxing_staging
MYSQL_USER=douxing
MYSQL_PASSWORD=请改为强密码
DOCKER_MYSQL_HOST_PORT=3308
DATABASE_URL=mysql://douxing:请改为强密码@127.0.0.1:3308/douxing_staging

# ---------- Redis（测试可用独立端口） ----------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6380
DOCKER_REDIS_HOST_PORT=6380

# ---------- 服务 ----------
SERVER_PORT=3001
NODE_ENV=production

# ---------- 安全（必填，可与生产不同） ----------
JWT_SECRET=请改为至少32位随机字符串-测试环境
JWT_EXPIRES_IN=7d

# ---------- 短信（测试建议 mock，避免误发） ----------
SMS_PROVIDER=mock
SMS_DEV_EXPOSE_CODE=true

# ---------- LLM ----------
LLM_ENABLED=true
LLM_DEFAULT_PROVIDER=auto
# DOUXING_LLM_MODEL=
# DOUXING_LLM_API_KEY=
# DOUXING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=

# ---------- C7 Agent（M2 · staging 灰度开启） ----------
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8100
AGENT_PLAN_ENABLED=true
AGENT_TOOL_SECRET=请改为随机长字符串-与-ai-service-一致
AGENT_PLAN_TIMEOUT_MS=180000
# Langfuse（可选，未配 KEY 时 no-op）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- 打卡围栏（测试可关闭便于联调） ----------
CHECKIN_GEOFENCE_ENABLED=false
