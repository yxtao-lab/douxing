# ============================================================
# 兜行 · 生产环境配置示例
# 复制到项目根目录并重命名为 .env：
#   cp deploy/env.production.example .env
# ============================================================

# ---------- 域名与对外地址（必填） ----------
# API 子域名，须已备案并解析到轻量服务器公网 IP
API_PUBLIC_BASE_URL=https://api.yxtao.site
VITE_API_BASE_URL=https://api.yxtao.site/api

# ---------- 数据库（Docker 生产 compose） ----------
MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=douxing
MYSQL_USER=douxing
MYSQL_PASSWORD=请改为强密码
DOCKER_MYSQL_HOST_PORT=3307
DATABASE_URL=mysql://douxing:请改为强密码@127.0.0.1:3307/douxing

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
DOCKER_REDIS_HOST_PORT=6379

# ---------- 服务 ----------
SERVER_PORT=3000
NODE_ENV=production

# ---------- 安全（必填） ----------
JWT_SECRET=请改为至少32位随机字符串
JWT_EXPIRES_IN=7d

# ---------- 短信（生产建议 tencent） ----------
SMS_PROVIDER=tencent
SMS_DEV_EXPOSE_CODE=false
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ---------- LLM（生产建议 DeepSeek，勿依赖本机 LM Studio） ----------
LLM_ENABLED=true
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# Python AI 微服务（可选）
# AI_SERVICE_ENABLED=true
# AI_SERVICE_URL=http://127.0.0.1:8100

# ---------- 微信支付（上线时配置） ----------
# PAYMENT_MODE=wechat
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=wx8bdbe398733ca0f0
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=./packages/server/certs/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_PATH=./packages/server/certs/apiclient_cert.pem
# WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/payments/wechat/notify
# WECHAT_MINI_APP_SECRET=

# ---------- 高德（可选） ----------
# AMAP_WEB_KEY=
# AMAP_ENABLED=true

# ---------- 打卡围栏（生产建议 true） ----------
CHECKIN_GEOFENCE_ENABLED=true
