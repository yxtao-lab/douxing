# ============================================================
# 兜行 · 生产环境配置示例
# 复制到项目根目录并重命名为 .env：
#   cp deploy/env.production.example .env
# ============================================================

# ---------- 域名与对外地址（必填） ----------
# API 子域名，须已备案并解析到轻量服务器公网 IP
API_PUBLIC_BASE_URL_PROD=https://api.yxtao.site
# 也可写 API_PUBLIC_BASE_URL 覆盖分环境配置
# API_PUBLIC_BASE_URL=https://api.yxtao.site
VITE_API_BASE_URL=https://api.yxtao.site/api

# Nginx 自动配置（deploy:server 末尾一步完成，HTTPS 已通则跳过）
NGINX_DOMAIN=api.yxtao.site
NGINX_AUTO_SETUP=true
# 首次 HTTPS 自动 Certbot（填邮箱后 deploy 一步到位；已有证书可留空）
NGINX_CERTBOT_EMAIL=

# ---------- PC 用户端静态站（P5） ----------
# 构建产物发布目录（pnpm deploy:release --target=pc）
STATIC_ROOT=/opt/douxing/static
# PC 子域名，Nginx 静态 + /api 反代
PC_NGINX_DOMAIN=pc.yxtao.site
# Web 管理端子域名
WEB_NGINX_DOMAIN=web.yxtao.site

# ---------- 数据库（Docker 生产 compose） ----------
MYSQL_ROOT_PASSWORD=sj13098830296
MYSQL_DATABASE=douxing
MYSQL_USER=douxing
MYSQL_PASSWORD=sj13098830296
DOCKER_MYSQL_HOST_PORT=3307
DATABASE_URL=mysql://douxing:sj13098830296@127.0.0.1:3307/douxing

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
DOCKER_REDIS_HOST_PORT=6379

# ---------- 服务 ----------
SERVER_PORT=3000
NODE_ENV=production
# 2G 轻量服务器建议 tsx（deploy 脚本内存≤4G 也会自动启用，免 server tsc 卡住）
SERVER_RUNTIME=tsx

# ---------- 安全（必填） ----------
JWT_SECRET=592250951a08954a3bf5469a429c2c577598829bd58e0d4c
JWT_EXPIRES_IN=7d

# 首次 seed 创建管理员（NODE_ENV=production 时生效；留空则 seed 不创建 admin，请用 reset-admin-password）
# 要求：≥12 位，含大小写字母与数字。用完后建议从 .env 删除或置空，避免明文长期留存
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# ---------- 短信（生产建议 tencent） ----------
SMS_PROVIDER=tencent
SMS_DEV_EXPOSE_CODE=false
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ---------- LLM（生产建议 DeepSeek，勿依赖本机 LM Studio） ----------
LLM_ENABLED=true
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# Python AI 微服务（可选）
# AI_SERVICE_ENABLED=true
# AI_SERVICE_URL=http://127.0.0.1:8100

# ---------- 微信支付（上线时配置） ----------
# PAYMENT_MODE=wechat
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=wx2c8d1e2b2e502819
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=./packages/server/certs/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_PATH=./packages/server/certs/apiclient_cert.pem
# WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/payments/wechat/notify
# WECHAT_MINI_APP_SECRET=

# ---------- 高德（可选） ----------
# AMAP_WEB_KEY=
# AMAP_ENABLED=true

# ---------- 打卡围栏（生产建议 true） ----------
CHECKIN_GEOFENCE_ENABLED=true

# ---------- Gitee Webhook 发版（方案 C，不用 Gitee Go） ----------
# 随机长字符串；与 Gitee 仓库 WebHook「密码」一致
WEBHOOK_SECRET=
WEBHOOK_PORT=9090
WEBHOOK_DEPLOY_BRANCHES=main,master
# auto=按变更 package 增量发版 | full=每次 server+pc+web 全量
WEBHOOK_DEPLOY_MODE=auto
WEBHOOK_DEPLOY_ALLOW=server,pc,web
# DEPLOY_PATH=/opt/douxing
