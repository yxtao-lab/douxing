# 兜行 API — Nginx 反向代理模板
# 1. 复制到 /etc/nginx/sites-available/douxing-api
# 2. 将 __DOMAIN__ 替换为你的 API 域名（如 api.example.com）
# 3. ln -s /etc/nginx/sites-available/douxing-api /etc/nginx/sites-enabled/
# 4. certbot --nginx -d __DOMAIN__  申请 HTTPS 证书
# 5. nginx -t && systemctl reload nginx

# HTTP → HTTPS 重定向（Certbot 会自动追加 SSL 块）
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Certbot 验证路径
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    # Certbot 会写入以下 ssl_* 指令；首次可先注释本 server 块，仅跑 certbot
    # ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    client_max_body_size 10m;

    # 上传文件（头像、打卡图）与 API 共用同一域名
    location /uploads/ {
        proxy_pass http://127.0.0.1:__SERVER_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:__SERVER_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # LLM 路线生成可能较慢
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
