# 兜行 API — Nginx 反向代理模板（首次仅 HTTP，Certbot 会自动追加 HTTPS）
# 1. pnpm deploy:server --nginx api.你的域名.com --skip-docker --skip-build
# 2. sudo cp deploy/nginx/douxing-api.conf /etc/nginx/sites-available/douxing-api
# 3. sudo ln -sf /etc/nginx/sites-available/douxing-api /etc/nginx/sites-enabled/
# 4. sudo rm -f /etc/nginx/sites-enabled/default
# 5. sudo nginx -t && sudo systemctl reload nginx
# 6. sudo certbot --nginx -d api.你的域名.com

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 10m;

    location /uploads/ {
        proxy_pass http://127.0.0.1:__SERVER_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Gitee Webhook 发版（可选，需先 bash scripts/install-webhook-service.sh）
    # include snippets/douxing-webhook.conf;

    location / {
        proxy_pass http://127.0.0.1:__SERVER_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

# Certbot 执行后会自动在本文件追加 listen 443 ssl 与证书路径，并将 HTTP 重定向到 HTTPS
