{
  "name": "douxing",
  "version": "1.0.0",
  "private": true,
  "description": "兜行 - 多端出行服务平台",
  "scripts": {
    "dev": "concurrently -k -n api,web,mobile,mp -c blue,green,magenta,yellow \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:mobile\" \"pnpm dev:mp-weixin\"",
    "dev:only": "node scripts/run-dev.mjs",
    "dev:web": "pnpm --filter @douxing/web dev",
    "dev:mobile": "pnpm --filter @douxing/mobile dev:h5",
    "dev:mp-weixin": "pnpm --filter @douxing/mobile dev:mp-weixin",
    "dev:app": "pnpm --filter @douxing/mobile dev:app",
    "dev:app-android": "pnpm --filter @douxing/mobile dev:app-android",
    "dev:app-ios": "pnpm --filter @douxing/mobile dev:app-ios",
    "dev:server": "pnpm --filter @douxing/shared build && pnpm --filter @douxing/server dev",
    "dev:ai-service": "node scripts/run-ai-service.mjs",
    "dev:with-ai": "concurrently -k -n api,ai,web,mobile,mp -c blue,cyan,green,magenta,yellow \"pnpm dev:server\" \"pnpm dev:ai-service\" \"pnpm dev:web\" \"pnpm dev:mobile\" \"pnpm dev:mp-weixin\"",
    "build": "pnpm run -r build",
    "build:only": "node scripts/run-build.mjs",
    "build:web": "pnpm --filter @douxing/web build",
    "build:web:staging": "pnpm --filter @douxing/web build:staging",
    "build:mobile": "pnpm --filter @douxing/mobile build:h5",
    "build:mobile:staging": "pnpm --filter @douxing/mobile build:h5:staging",
    "build:mp-weixin": "pnpm --filter @douxing/mobile build:mp-weixin",
    "build:mp-weixin:staging": "pnpm --filter @douxing/mobile build:mp-weixin:staging",
    "build:mp-weixin:prod": "pnpm --filter @douxing/mobile build:mp-weixin",
    "build:app": "pnpm --filter @douxing/mobile build:app",
    "build:app-android": "pnpm --filter @douxing/mobile build:app-android",
    "build:app-ios": "pnpm --filter @douxing/mobile build:app-ios",
    "build:app-all": "node scripts/run-build.mjs app-android,app-ios",
    "build:app-all:staging": "pnpm --filter @douxing/mobile build:app-all:staging",
    "build:server": "pnpm --filter @douxing/shared build && pnpm --filter @douxing/server build",
    "deploy:app": "node scripts/deploy-app.mjs",
    "deploy:app:dev": "node scripts/deploy-app.mjs --with-backend --dev",
    "deploy:app:full": "node scripts/deploy-app.mjs --with-backend",
    "db:migrate": "pnpm --filter @douxing/server db:migrate",
    "db:seed": "pnpm --filter @douxing/server db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:reset": "pnpm --filter @douxing/server db:reset",
    "bootstrap": "node scripts/deploy.mjs",
    "bootstrap:dev": "node scripts/deploy.mjs --skip-build --dev",
    "deploy:server": "node scripts/deploy-server.mjs",
    "deploy:server:check": "node scripts/deploy-server.mjs --check",
    "deploy:server:tsx": "node scripts/deploy-server.mjs --skip-docker --use-tsx",
    "setup:debian12": "bash scripts/setup-debian12.sh",
    "setup:ubuntu22": "bash scripts/setup-ubuntu22.sh",
    "setup:opencloudos9": "bash scripts/setup-opencloudos9.sh",
    "setup:nginx-conf": "bash scripts/install-nginx-conf.sh",
    "diagnose:server": "bash scripts/diagnose-server.sh",
    "stop": "node scripts/stop.mjs",
    "stop:dev": "node scripts/stop.mjs --skip-docker",
    "stop:docker": "node scripts/stop.mjs --docker-only",
    "preview:web": "pnpm --filter @douxing/web preview",
    "lint": "pnpm run -r lint --if-present"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "pm2": "^5.4.3"
  }
}
